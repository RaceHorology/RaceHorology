  <?define RaceHorology_TargetDir = $(var.RaceHorology.TargetDir) ?>

  <Product Id="*" Name="Race Horology" Language="1033" Codepage="UTF-8" Version="!(bind.fileVersion.RaceHorology.exe)" Manufacturer="Sven Flossmann" UpgradeCode="d9e1706b-6d76-415d-8e23-ede1bab60b83">
    <Package InstallerVersion="200" Compressed="yes" InstallScope="perMachine" />

    <Icon Id="RHLOGOFINAPP.ico" SourceFile="RH-LOGO-FIN-APP2.ico" />
    <Property Id="ARPPRODUCTICON" Value="RHLOGOFINAPP.ico" />

    <MajorUpgrade Schedule="afterInstallValidate" AllowDowngrades="no" DowngradeErrorMessage="Eine neuere Version von [ProductName] ist bereits installiert." />
    <MediaTemplate EmbedCab="yes" />

    <Feature Id="MainProgram" Title="Race Horology" Level="1">
      <ComponentRef Id="ApplicationShortcut" />
      <ComponentGroupRef Id="runtimes_win_x86_native_files" />
      <!-- Harvested by Heat from the RaceHorologyWeb build output, see RaceHorologySetup.wixproj -->
      <ComponentGroupRef Id="webroot_files" />
      <ComponentGroupRef Id="INSTALLFOLDER_files" />
      <ComponentGroupRef Id="raceconfigpresets_files" />
      <ComponentGroupRef Id="dbtemplates_files" />
      <ComponentGroupRef Id="resources_files" />
      <ComponentGroupRef Id="resources_pdf_files" />
    </Feature>

    <Feature Id="ThirdParty" Title="3rd Party" Level="1">
      <ComponentGroupRef Id="ThirdPartyComponents" />
    </Feature>

    <PropertyRef Id="WIX_IS_NETFRAMEWORK_462_OR_LATER_INSTALLED" />
    <Condition Message="[ProductName] benötigt NET Framework 4.6.2. Bitte installiere .NET Framework separat und probiere es noch einmal.">
      <![CDATA[Installed OR WIX_IS_NETFRAMEWORK_462_OR_LATER_INSTALLED]]>
    </Condition>

    <Property Id="WIXUI_INSTALLDIR" Value="INSTALLFOLDER" />
    <UIRef Id="WixUI_InstallDir" />
    <UIRef Id="WixUI_ErrorProgressText" />
    <WixVariable Id="WixUILicenseRtf" Value="RaceHorologyLicense.rtf" />

    <WixVariable Id="WixUIBannerBmp" Value="WixUIBannerBmp.bmp" />
    <WixVariable Id="WixUIDialogBmp" Value="WixUIDialogBmp.bmp" />
  </Product>

