<local:TimingDeviceBaseUC x:Class="RaceHorology.TimingDeviceDebugUC"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:RaceHorology"
        d:DesignHeight="400" d:DesignWidth="500"
        mc:Ignorable="d" 
        >
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <Label Content="Protokoll:" Grid.Row="0"/>
    <TextBox x:Name="tbAlgeLog" Grid.Row="1" Margin="5" TextWrapping="Wrap" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" IsReadOnly="True" VerticalScrollBarVisibility="Auto"/>
    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="5,0,5,5">
      <CheckBox x:Name="chkAutoScroll" Content="Automatisch scrollen" IsChecked="True" VerticalAlignment="Center" Margin="0,0,10,0" Checked="chkAutoScroll_Checked"/>
      <Button x:Name="btnClear" Content="Leeren" Width="75" Click="btnClear_Click"/>
    </StackPanel>
  </Grid>
</local:TimingDeviceBaseUC>
